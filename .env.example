# 任选一种 OpenAI-compatible 模型配置。Key 只放服务端 .env.local，绝不能写进前端或提交 Git。
# 方案 A：DeepSeek（推荐给当前项目）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# 方案 B：OpenAI；如果两组 Key 都填写，优先使用 OpenAI。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# 配方比例由约束优化求解器决定，不依赖 LLM。
# 只要配置了 Key，解释文案默认调用 LLM；如需强制本地模板，设为 false。
EXPLAIN_LLM=true

# 记录存储：Neon Postgres（有值则优先数据库，否则写本地 runtime/records/*.jsonl）
DATABASE_URL=
POSTGRES_URL=

# 本机 Python Hardware Bridge；留空时只模拟百分比→克数换算，不连接 STM32。
HARDWARE_API_URL=http://127.0.0.1:8765/v1/jobs
# 可选：与 Bridge 的 HARDWARE_API_TOKEN 保持一致。
HARDWARE_API_TOKEN=
